PORT=3000
NODE_ENV=development
JWT_SECRET=cambia-este-secreto
ADMIN_PASSWORD=admin123

# Opcion 1: URL completa (recomendado para Fly.io)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/inventario

# Opcion 2: Variables separadas (si no usas DATABASE_URL)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=inventario
PGSSL=false